# The FastAPI app and pipeline currently don't require any secrets --
# SQLite is a local file and there are no third-party API keys used directly
# in this repo's own code (the LLM call lives inside the n8n workflow, where
# the Anthropic API key is stored as an n8n credential, not here).
#
# This file is kept as a placeholder / extension point, e.g. if you swap
# SQLite for Postgres per the "5000 users" stretch doc:
# DATABASE_URL=postgresql://user:password@localhost:5432/consultbae
